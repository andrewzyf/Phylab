# Copy to .env (or export these) before `npm start` / `npm run dev`.

# Enables AI interpretation. Without it PhysicsLab uses its built-in rule-based interpreter.
ANTHROPIC_API_KEY=

# Model and reasoning effort for interpreting descriptions (low | medium | high | xhigh | max).
PHYSICSLAB_MODEL=claude-opus-5-5
PHYSICSLAB_EFFORT=medium
PHYSICSLAB_EXPLAIN_EFFORT=low

# Set to "off" to force the offline interpreter even when a key is present.
# PHYSICSLAB_AI=off

# AI requests allowed per client IP per minute (excess requests use the offline interpreter).
PHYSICSLAB_RATE_LIMIT=20

PORT=8787
# PHYSICSLAB_CORS_ORIGIN=https://your-frontend.example
